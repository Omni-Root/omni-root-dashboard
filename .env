# Ambiente LOCAL de desenvolvimento — já vem pronto no zip para funcionar com o
# Postgres de teste do Docker (db/dev/docker-compose.yml). NÃO vai para o Git.
#
# Quando forem usar o banco central de verdade, troque só as linhas PG_*
# (host/IP real, porta 5432, senha real; PG_SSL=true se exigir TLS).

PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=dev
PG_DBNAME=desafio_madeira
PG_SSL=false

# Porta da API de leitura (o Vite dev server usa proxy para ela)
API_PORT=3001

# --- Autenticação do dashboard ---
# Credenciais da tela de login. Troque a senha quando quiser.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=root

# Segredo que assina o cookie de sessão. Opcional: sem ele, um segredo
# aleatório é gerado a cada boot (as sessões caem quando o servidor reinicia).
SESSION_SECRET=
