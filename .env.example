# Copie para ".env" e preencha. O .env real nunca vai pro Git.
# Nomes idênticos aos usados pelo sync.go / .env.example do repo principal.

PG_HOST=192.168.1.100
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DBNAME=desafio_madeira

# "true" se o Postgres central exigir TLS (ex.: nuvem gerenciada)
PG_SSL=false

# Porta da API de leitura (o Vite dev server usa proxy para ela)
API_PORT=3001

# --- Autenticação do dashboard ---
# Credenciais de acesso à interface (obrigatórias — o login falha sem elas).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=troque-esta-senha

# Segredo que assina o cookie de sessão. Opcional: sem ele, um segredo
# aleatório é gerado a cada boot (as sessões caem quando o servidor reinicia).
SESSION_SECRET=

# --- Login social (Google, Facebook, GitHub) — opcional ---
# Só entra quem estiver nesta lista (e-mails exatos e/ou domínios inteiros
# começando com @), separados por vírgula. VAZIA = login social desligado
# (os botões aparecem desativados). O login acima (admin) continua valendo.
#   OAUTH_PERMITIDOS=ana@empresa.com, @fiap.com.br
OAUTH_PERMITIDOS=
#
# Em cada provedor, crie um "app OAuth" e cadastre o endereço de retorno
# (troque a base se o painel não abrir em http://localhost:5173):
#   Google   -> console.cloud.google.com > APIs e serviços > Credenciais >
#               ID do cliente OAuth (Aplicativo da Web)
#               retorno: http://localhost:5173/api/auth/google/retorno
#   Facebook -> developers.facebook.com > Meus apps > Login do Facebook
#               retorno: http://localhost:5173/api/auth/facebook/retorno
#   GitHub   -> github.com/settings/developers > OAuth Apps
#               retorno: http://localhost:5173/api/auth/github/retorno
# Botão sem as duas variáveis do provedor = desativado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Opcional: base fixa do endereço de retorno (ex.: atrás de HTTPS/proxy).
# Vazio = a do próprio navegador (http://localhost:5173 em desenvolvimento).
OAUTH_URL_BASE=

# --- Câmera ao vivo (quadros empurrados pelo main.py da máquina) ---
# Token que a máquina envia no header X-Stream-Token. Sem ele, a rota
# /api/camera/frame fica desligada (503). Mesmo valor do STREAM_TOKEN no
# .env do repositório principal. Opcional: CAMERA_OFFLINE_MS (padrão 4000)
# = idade do último quadro a partir da qual o painel mostra "Sem sinal".
STREAM_TOKEN=
