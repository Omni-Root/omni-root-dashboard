# Copie para ".env" e preencha. O .env real nunca vai pro Git.
# Nomes idênticos aos usados pelo sync.go / .env.example do repo principal.

PG_HOST=192.168.1.100
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DBNAME=desafio_madeira

# "true" se o Postgres central exigir TLS (ex.: nuvem gerenciada)
PG_SSL=false

# Porta da API de leitura (o Vite dev server usa proxy para ela)
API_PORT=3001

# --- Autenticação do dashboard ---
# Credenciais de acesso à interface (obrigatórias — o login falha sem elas).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=troque-esta-senha

# Segredo que assina o cookie de sessão. Opcional: sem ele, um segredo
# aleatório é gerado a cada boot (as sessões caem quando o servidor reinicia).
SESSION_SECRET=
